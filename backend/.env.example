# --- OPCIÓN 1: Supabase Directo (Recomendado para Render / Servidores con IPv6) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db.ufpqhueytunmdwiwtezd.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu_contrasena_supabase_aqui

# --- OPCIÓN 2: Supabase Pooler IPv4 (Para correr en PC Windows local con Supabase) ---
# En tu panel de Supabase: Connect -> Method = Session (puerto 5432)
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.ufpqhueytunmdwiwtezd
# SPRING_DATASOURCE_PASSWORD=tu_contrasena_supabase_aqui

# --- OPCIÓN 3: Desarrollo 100% Offline / Local en PC con H2 en memoria ---
# Descomenta esta línea para correr en IntelliJ sin necesidad de red ni internet:
# SPRING_PROFILES_ACTIVE=local

# Puerto de Ejecución
PORT=8080

# Seguridad JWT
JWT_SECRET=TuClaveSecretaSuperSeguraDe256BitsParaHMACSHA256!
JWT_EXPIRATION_MS=86400000

# Proveedor de Correo
MAIL_PROVIDER=auto
MAIL_FROM=Angel Shot <onboarding@resend.dev>
RESEND_API_KEY=
